{
  "bindings": [
    {
      "authLevel": "anonymous",
      "type": "httpTrigger",
      "direction": "in",
      "name": "Request",
      "methods": ["post"],
      "route": "file-email-batch/{batchId}"
    },
    {
      "type": "http",
      "direction": "out",
      "name": "Response"
    },
    {
      "type": "blob",
      "direction": "out",
      "name": "BatchBlob",
      "path": "file-email-batches/{batchId}.json",
      "connection": "AzureWebJobsStorage"
    }
  ]
}
