<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" 
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xsi:type="MailApp">
  
  <Id>619b06f8-0000-4b8a-8a1a-000000000000</Id>
  <Version>1.0.0.11</Version>
  <ProviderName>Summation Group</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Summation Assistant" />
  <Description DefaultValue="AI-powered automation tools for Summation Group." />
  
  <IconUrl DefaultValue="https://prassummation.github.io/outlook-addin/logo-symbol-32x32.png" />
  <HighResolutionIconUrl DefaultValue="https://prassummation.github.io/outlook-addin/logo-symbol-80x80.png" />
  <SupportUrl DefaultValue="https://prassummation.github.io/outlook-addin/" />

  <!-- Added alongside LaunchEvent/OnMessageSend: Office.context.ui.displayDialogAsync's own
       rule is that its target URL's domain must either match the add-in's own origin or be
       listed here. The file-on-send picker dialog (built in a later phase, on top of this
       same LaunchEvent registration) will be same-origin already, so this is very likely
       unnecessary, but it's free to declare now, and far cheaper than discovering a client
       that enforces it strictly only after that dialog is already built and deployed. -->
  <AppDomains>
    <AppDomain>https://prassummation.github.io</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Mailbox" />
  </Hosts>

  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1" />
    </Sets>
  </Requirements>

  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://prassummation.github.io/outlook-addin/taskpane.html" />
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <Permissions>ReadWriteMailbox</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read" />
  </Rule>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.3">
        <bt:Set Name="Mailbox" />
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="SummationToolsGroup">
                <Label resid="GroupLabel" />
                <Control xsi:type="Button" id="Summation.TaskpaneButton">
                  <Label resid="TaskpaneButtonLabel" />
                  <Supertip>
                    <Title resid="TaskpaneButtonLabel" />
                    <Description resid="TaskpaneButtonToolTip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16" />
                    <bt:Image size="32" resid="Icon.32x32" />
                    <bt:Image size="80" resid="Icon.80x80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>
                <Control xsi:type="Button" id="Summation.FileEmailButton">
                  <Label resid="FileEmailButtonLabel" />
                  <Supertip>
                    <Title resid="FileEmailButtonLabel" />
                    <Description resid="FileEmailButtonToolTip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16" />
                    <bt:Image size="32" resid="Icon.32x32" />
                    <bt:Image size="80" resid="Icon.80x80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="FileEmail.Url" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>

          <ExtensionPoint xsi:type="MessageComposeCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="SummationToolsComposeGroup">
                <Label resid="GroupLabel" />
                <Control xsi:type="Button" id="Summation.ComposeTaskpaneButton">
                  <Label resid="TaskpaneButtonLabel" />
                  <Supertip>
                    <Title resid="TaskpaneButtonLabel" />
                    <Description resid="TaskpaneButtonToolTip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16" />
                    <bt:Image size="32" resid="Icon.32x32" />
                    <bt:Image size="80" resid="Icon.80x80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://prassummation.github.io/outlook-addin/logo-symbol-16x16.png" />
        <bt:Image id="Icon.32x32" DefaultValue="https://prassummation.github.io/outlook-addin/logo-symbol-32x32.png" />
        <bt:Image id="Icon.80x80" DefaultValue="https://prassummation.github.io/outlook-addin/logo-symbol-80x80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Taskpane.Url" DefaultValue="https://prassummation.github.io/outlook-addin/taskpane.html" />
        <bt:Url id="FileEmail.Url" DefaultValue="https://prassummation.github.io/outlook-addin/taskpane.html?view=fileEmail" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GroupLabel" DefaultValue="Summation Tools" />
        <bt:String id="TaskpaneButtonLabel" DefaultValue="Summation Assistant" />
        <bt:String id="FileEmailButtonLabel" DefaultValue="File Email" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="TaskpaneButtonToolTip" DefaultValue="Open the Summation AI helper." />
        <bt:String id="FileEmailButtonToolTip" DefaultValue="Tag the selected email(s) with a project and stage them for filing." />
      </bt:LongStrings>
    </Resources>

    <!-- V1.1 nested block: lets the taskpane's File Email wizard activate on multiple
         selected messages at once (SupportsMultiSelect) and even with no single item open
         (SupportsNoItemContext).
         A client that understands this block reads it INSTEAD of the V1.0 content above,
         not in addition to it, so it has to re-declare both buttons, not just the new
         capability, and carries its own complete Resources section. Clients that don't
         understand V1.1 fall back to the unchanged V1.0 content above, so this is purely
         additive for them. -->
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.15">
          <bt:Set Name="Mailbox" />
        </bt:Sets>
      </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <DesktopFormFactor>
            <!-- File-on-send, phase 1: prove OnMessageSend actually fires in this tenant's
                 Outlook clients before building the real "pick a project" dialog on top of
                 it (see the separately-approved File on Send mockup). onMessageSendHandler
                 in commands.html never blocks or delays sending, it only leaves a visible
                 notification on the item, and always allows the send either way. SendMode
                 "SoftBlock" additionally means Outlook itself lets the send through if this
                 handler ever errors or times out, so a bug here can't trap someone's email
                 mid-send. -->
            <FunctionFile resid="Commands.Url" />
            <ExtensionPoint xsi:type="LaunchEvent">
              <LaunchEvents>
                <LaunchEvent Type="OnMessageSend" FunctionName="onMessageSendHandler" SendMode="SoftBlock" />
              </LaunchEvents>
              <SourceLocation resid="Commands.Url" />
            </ExtensionPoint>

            <ExtensionPoint xsi:type="MessageReadCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="SummationToolsGroup">
                  <Label resid="GroupLabel" />
                  <Control xsi:type="Button" id="Summation.TaskpaneButton">
                    <Label resid="TaskpaneButtonLabel" />
                    <Supertip>
                      <Title resid="TaskpaneButtonLabel" />
                      <Description resid="TaskpaneButtonToolTip" />
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.16x16" />
                      <bt:Image size="32" resid="Icon.32x32" />
                      <bt:Image size="80" resid="Icon.80x80" />
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="Taskpane.Url" />
                      <SupportsPinning>true</SupportsPinning>
                      <SupportsNoItemContext>true</SupportsNoItemContext>
                      <SupportsMultiSelect>true</SupportsMultiSelect>
                    </Action>
                  </Control>
                  <Control xsi:type="Button" id="Summation.FileEmailButton">
                    <Label resid="FileEmailButtonLabel" />
                    <Supertip>
                      <Title resid="FileEmailButtonLabel" />
                      <Description resid="FileEmailButtonToolTip" />
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.16x16" />
                      <bt:Image size="32" resid="Icon.32x32" />
                      <bt:Image size="80" resid="Icon.80x80" />
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="FileEmail.Url" />
                      <SupportsPinning>true</SupportsPinning>
                      <SupportsNoItemContext>true</SupportsNoItemContext>
                      <SupportsMultiSelect>true</SupportsMultiSelect>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>

            <ExtensionPoint xsi:type="MessageComposeCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="SummationToolsComposeGroup">
                  <Label resid="GroupLabel" />
                  <Control xsi:type="Button" id="Summation.ComposeTaskpaneButton">
                    <Label resid="TaskpaneButtonLabel" />
                    <Supertip>
                      <Title resid="TaskpaneButtonLabel" />
                      <Description resid="TaskpaneButtonToolTip" />
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.16x16" />
                      <bt:Image size="32" resid="Icon.32x32" />
                      <bt:Image size="80" resid="Icon.80x80" />
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="Taskpane.Url" />
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>
      <Resources>
        <bt:Images>
          <bt:Image id="Icon.16x16" DefaultValue="https://prassummation.github.io/outlook-addin/logo-symbol-16x16.png" />
          <bt:Image id="Icon.32x32" DefaultValue="https://prassummation.github.io/outlook-addin/logo-symbol-32x32.png" />
          <bt:Image id="Icon.80x80" DefaultValue="https://prassummation.github.io/outlook-addin/logo-symbol-80x80.png" />
        </bt:Images>
        <bt:Urls>
          <bt:Url id="Taskpane.Url" DefaultValue="https://prassummation.github.io/outlook-addin/taskpane.html" />
          <bt:Url id="FileEmail.Url" DefaultValue="https://prassummation.github.io/outlook-addin/taskpane.html?view=fileEmail" />
          <bt:Url id="Commands.Url" DefaultValue="https://prassummation.github.io/outlook-addin/commands.html" />
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="GroupLabel" DefaultValue="Summation Tools" />
          <bt:String id="TaskpaneButtonLabel" DefaultValue="Summation Assistant" />
          <bt:String id="FileEmailButtonLabel" DefaultValue="File Email" />
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="TaskpaneButtonToolTip" DefaultValue="Open the Summation AI helper." />
          <bt:String id="FileEmailButtonToolTip" DefaultValue="Tag the selected email(s) with a project and stage them for filing." />
        </bt:LongStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
