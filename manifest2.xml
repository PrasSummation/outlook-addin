<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" 
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0" 
           xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0" 
           xsi:type="MailApp">
  
  <Id>619b06f8-0000-4b8a-8a1a-000000000000</Id> 
  <Version>1.0.0.2</Version>
  <ProviderName>Summation Group</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Summation Assistant" />
  <Description DefaultValue="AI-powered automation tools for Summation Group." />
  
  <IconUrl DefaultValue="https://prassummation.github.io/outlook-addin/assets/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://prassummation.github.io/outlook-addin/assets/icon-80.png" />

  <Hosts>
    <Host Name="Mailbox" />
  </Hosts>

  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1" />
    </Sets>
  </Requirements>

  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://prassummation.github.io/outlook-addin/taskpane.html" />
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <Permissions>ReadWriteMailbox</Permissions>
  <Rule xsi:type="RuleCollection" Mode="MatchAll">
    <Rule xsi:type="ItemIs" ItemType="Message" />
  </Rule>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.0" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.3">
        <bt:Set Name="Mailbox" />
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="Mailbox">
        <DesktopFormFactor>
          <FunctionFile resid="Commands.Url" />

          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="mso_c1.583AC9C6">
                <Label resid="GroupLabel" />
                <Control xsi:type="Button" id="Summation.TaskpaneButton">
                  <Label resid="TaskpaneButtonLabel" />
                  <Supertip>
                    <Title resid="TaskpaneButtonLabel" />
                    <Description resid="TaskpaneButtonToolTip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16" />
                    <bt:Image size="32" resid="Icon.32x32" />
                    <bt:Image size="80" resid="Icon.80x80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>

          <ExtensionPoint xsi:type="MessageComposeCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="mso_c1.583AC9C6">
                <Label resid="GroupLabel" />
                <Control xsi:type="Button" id="Summation.ComposeTaskpaneButton">
                  <Label resid="TaskpaneButtonLabel" />
                  <Supertip>
                    <Title resid="TaskpaneButtonLabel" />
                    <Description resid="TaskpaneButtonToolTip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16" />
                    <bt:Image size="32" resid="Icon.32x32" />
                    <bt:Image size="80" resid="Icon.80x80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://prassummation.github.io/outlook-addin/assets/icon-16.png" />
        <bt:Image id="Icon.32x32" DefaultValue="https://prassummation.github.io/outlook-addin/assets/icon-32.png" />
        <bt:Image id="Icon.80x80" DefaultValue="https://prassummation.github.io/outlook-addin/assets/icon-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Commands.Url" DefaultValue="https://prassummation.github.io/outlook-addin/commands.html" />
        <bt:Url id="Taskpane.Url" DefaultValue="https://prassummation.github.io/outlook-addin/taskpane.html" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GroupLabel" DefaultValue="Summation Tools" />
        <bt:String id="TaskpaneButtonLabel" DefaultValue="Summation Assistant" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="TaskpaneButtonToolTip" DefaultValue="Open the Summation AI helper to summarize or draft emails." />
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
