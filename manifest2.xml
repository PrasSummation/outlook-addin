<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" 
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xsi:type="MailApp">
  
  <Id>619b06f8-0000-4b8a-8a1a-000000000000</Id>
  <Version>1.0.0.21</Version>
  <ProviderName>Summation Group</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Summation Assistant" />
  <Description DefaultValue="AI-powered automation tools for Summation Group." />
  
  <IconUrl DefaultValue="https://prassummation.github.io/outlook-addin/logo-symbol-32x32.png" />
  <HighResolutionIconUrl DefaultValue="https://prassummation.github.io/outlook-addin/logo-symbol-80x80.png" />
  <SupportUrl DefaultValue="https://prassummation.github.io/outlook-addin/" />

  <!-- https://prassummation.github.io: displayDialogAsync's own target-URL rule (its domain
       must match the add-in's origin or be listed here); file-on-send-dialog.html and
       file-email-dialog.html are same-origin already, so this one is technically redundant,
       kept for clarity anyway.

       https://login.microsoftonline.com: NOT redundant; added 2026-10-07 after a live
       incident. This is MSAL's authority host (see msalConfig.auth.authority in both
       dialogs), and AppDomains governs more than just displayDialogAsync's own target; it
       also gates navigation *inside* an already-open dialog, which is exactly what MSAL
       does for both acquireTokenSilent (a hidden iframe) and loginPopup (an actual popup
       window); both navigate here. Without this listed, Office's dialog host can block
       that navigation silently rather than raising a catchable error, so the MSAL call
       just hangs forever instead of resolving or rejecting. Root-caused this way: it only
       ever failed for someone signing in fresh (no cached token, so acquireTokenSilent
       actually needed the network round-trip), never for an already-signed-in session
       resolving straight from its local token cache, which is exactly the difference
       between "worked when tested" and "hung for a teammate." -->
  <AppDomains>
    <AppDomain>https://prassummation.github.io</AppDomain>
    <AppDomain>https://login.microsoftonline.com</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Mailbox" />
  </Hosts>

  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1" />
    </Sets>
  </Requirements>

  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://prassummation.github.io/outlook-addin/taskpane.html" />
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <Permissions>ReadWriteMailbox</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read" />
  </Rule>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.3">
        <bt:Set Name="Mailbox" />
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="SummationToolsGroup">
                <Label resid="GroupLabel" />
                <Control xsi:type="Button" id="Summation.TaskpaneButton">
                  <Label resid="TaskpaneButtonLabel" />
                  <Supertip>
                    <Title resid="TaskpaneButtonLabel" />
                    <Description resid="TaskpaneButtonToolTip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16" />
                    <bt:Image size="32" resid="Icon.32x32" />
                    <bt:Image size="80" resid="Icon.80x80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>
                <Control xsi:type="Button" id="Summation.FileEmailButton">
                  <Label resid="FileEmailButtonLabel" />
                  <Supertip>
                    <Title resid="FileEmailButtonLabel" />
                    <Description resid="FileEmailButtonToolTip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16" />
                    <bt:Image size="32" resid="Icon.32x32" />
                    <bt:Image size="80" resid="Icon.80x80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="FileEmail.Url" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>

          <ExtensionPoint xsi:type="MessageComposeCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="SummationToolsComposeGroup">
                <Label resid="GroupLabel" />
                <Control xsi:type="Button" id="Summation.ComposeTaskpaneButton">
                  <Label resid="TaskpaneButtonLabel" />
                  <Supertip>
                    <Title resid="TaskpaneButtonLabel" />
                    <Description resid="TaskpaneButtonToolTip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16" />
                    <bt:Image size="32" resid="Icon.32x32" />
                    <bt:Image size="80" resid="Icon.80x80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://prassummation.github.io/outlook-addin/logo-symbol-16x16.png" />
        <bt:Image id="Icon.32x32" DefaultValue="https://prassummation.github.io/outlook-addin/logo-symbol-32x32.png" />
        <bt:Image id="Icon.80x80" DefaultValue="https://prassummation.github.io/outlook-addin/logo-symbol-80x80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Taskpane.Url" DefaultValue="https://prassummation.github.io/outlook-addin/taskpane.html" />
        <bt:Url id="FileEmail.Url" DefaultValue="https://prassummation.github.io/outlook-addin/taskpane.html?view=fileEmail" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GroupLabel" DefaultValue="Summation Tools" />
        <bt:String id="TaskpaneButtonLabel" DefaultValue="Summation Assistant" />
        <bt:String id="FileEmailButtonLabel" DefaultValue="File Email" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="TaskpaneButtonToolTip" DefaultValue="Open the Summation AI helper." />
        <bt:String id="FileEmailButtonToolTip" DefaultValue="Tag the selected email(s) with a project and stage them for filing." />
      </bt:LongStrings>
    </Resources>

    <!-- V1.1 nested block: lets the taskpane's File Email wizard activate on multiple
         selected messages at once (SupportsMultiSelect) and even with no single item open
         (SupportsNoItemContext).
         A client that understands this block reads it INSTEAD of the V1.0 content above,
         not in addition to it, so it has to re-declare both buttons, not just the new
         capability, and carries its own complete Resources section. Clients that don't
         understand V1.1 fall back to the unchanged V1.0 content above, so this is purely
         additive for them. -->
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.15">
          <bt:Set Name="Mailbox" />
        </bt:Sets>
      </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <!-- File on Send, live as of 2026-10-06: onMessageSendHandler (commands.js) opens
               file-on-send-dialog.html, the real "pick a project" picker built from the
               separately-approved mockup (https://claude.ai/artifact/EqTMRsGos3VHXtspmZPXpp).
               The user can file the email (tagging it and, for a reply/forward, optionally
               the original too), or cancel the send entirely and go back to the draft.

               SendMode changed from "SoftBlock" to "PromptUser" on 2026-10-21, after re-enabling
               FILE_ON_SEND_ENABLED (commands.js) following the 2026-10-16 live-blocking incident.
               Once onMessageSendHandler calls event.completed() with the Take Action commandId,
               Outlook shows its own native Smart Alerts dialog, and SoftBlock's "fails open on
               handler error/hang/timeout" safety net only covers the handler itself; it does NOT
               add a "Send Anyway" option to that native dialog once shown. That's exactly what
               trapped a user mid-send last time: the dialog appeared correctly, but the
               categorize step inside it didn't complete, and SoftBlock's own dialog offered no
               way past "Choose project" (which led into the stuck step) or "Don't Send" (abandon
               the draft). PromptUser's dialog does include a "Send Anyway" override, giving a
               real escape hatch even if the categorize-and-file flow misbehaves again. The root
               causes found during the 2026-10-16 to 2026-10-21 debugging (a Graph GET 404 right
               after saveAsync(), the master-category cleanup race, the compose-mode
               item.subject object bug, and Save Both's dialog killing its own bridge request
               before it landed) are now believed fixed, but this flip is being made cautiously
               given the history; see CLAUDE.md's "File on Send" section before changing this
               again, and strongly consider scoping this deployment to a single test account in
               the Microsoft 365 admin center before it reaches other staff.

               Runtimes is required for classic Outlook on Windows specifically: that client
               runs the event handler in a JavaScript-only runtime that loads commands.js
               directly (no HTML, no office.js script tag, no Office.onReady, see
               https://learn.microsoft.com/office/dev/add-ins/develop/event-based-activation).
               Every other client (web, new Outlook on Windows, Mac) uses the browser
               runtime instead, loading commands.html, which in turn pulls in that same
               commands.js via an ordinary <script> tag. Omitting Runtimes still passes
               basic schema validation (it's why the phase-1 manifest validated clean
               locally despite missing it) but silently means the handler would never fire
               on classic Windows Outlook at all. -->
          <Runtimes>
            <Runtime resid="Commands.Url">
              <Override type="javascript" resid="CommandsJs.Url" />
            </Runtime>
          </Runtimes>
          <DesktopFormFactor>
            <FunctionFile resid="Commands.Url" />
            <ExtensionPoint xsi:type="LaunchEvent">
              <LaunchEvents>
                <LaunchEvent Type="OnMessageSend" FunctionName="onMessageSendHandler" SendMode="PromptUser" />
                <!-- Added 2026-10-13, replacing an earlier SPIKE that tried to force the task
                     pane open via a shared runtime (Outlook doesn't support shared runtimes at
                     all, confirmed empirically, see git history). onMessageComposeHandler
                     (commands.js) instead adds an InsightMessage notification with a
                     ShowTaskPane action; Outlook opens the pane natively when the user clicks
                     it, same as clicking Summation.ComposeTaskpaneButton manually.
                     OnMessageCompose (Mailbox 1.12, covered by this block's 1.15 minimum) fires
                     on new/reply/reply-all/forward AND on reopening an existing draft,
                     broader than OnNewMessageCompose, which misses drafts. -->
                <LaunchEvent Type="OnMessageCompose" FunctionName="onMessageComposeHandler" />
              </LaunchEvents>
              <SourceLocation resid="Commands.Url" />
            </ExtensionPoint>

            <ExtensionPoint xsi:type="MessageReadCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="SummationToolsGroup">
                  <Label resid="GroupLabel" />
                  <Control xsi:type="Button" id="Summation.TaskpaneButton">
                    <Label resid="TaskpaneButtonLabel" />
                    <Supertip>
                      <Title resid="TaskpaneButtonLabel" />
                      <Description resid="TaskpaneButtonToolTip" />
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.16x16" />
                      <bt:Image size="32" resid="Icon.32x32" />
                      <bt:Image size="80" resid="Icon.80x80" />
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="Taskpane.Url" />
                      <SupportsPinning>true</SupportsPinning>
                      <SupportsNoItemContext>true</SupportsNoItemContext>
                      <SupportsMultiSelect>true</SupportsMultiSelect>
                    </Action>
                  </Control>
                  <!-- Reverted to ShowTaskpane 2026-10-16, undoing the 2026-10-06
                       ExecuteFunction change. That change traded away multi-select to fix a
                       keyboard-focus bug: ExecuteFunction/ShowTaskpane is purely about what
                       Outlook does before any of our JS runs, not what the user ultimately
                       sees, both routes end at the exact same file-email-dialog.html dialog.
                       SupportsMultiSelect/SupportsNoItemContext can ONLY be declared on
                       ShowTaskpane per the Action element schema (confirmed via Microsoft's own
                       spam-reporting add-in docs, which describe identical behavior: an
                       ExecuteFunction button becomes unavailable whenever multiple messages are
                       selected). The 2026-10-13 schema fix that removed those two elements from
                       this button's ExecuteFunction action (they were already invalid there)
                       didn't cause the multi-select bug; it only removed dead markup that
                       was never doing anything; the bug traces back to 2026-10-06 itself, just
                       unnoticed until now. Confirmed live: multi-select showed the button
                       visibly running (Outlook's "still working on your request" message) but
                       never completing, consistent with getSelectedItemsAsync() inside
                       detectFileEmailSelectionCmd() (commands.js) never resolving when called
                       from a command Outlook hasn't been told supports multi-select, rather
                       than a hard refusal to invoke the command at all.
                       Reverting restores the dormant pre-2026-10-06 path unchanged:
                       FileEmail.Url (taskpane.html?view=fileEmail) -> feDeepLinkRequested ->
                       openFileEmailDialog(), already proven live via the V1.0 fallback below
                       this whole time. Trade-off reaccepted: the freshly-opened task pane this
                       introduces as a stepping stone to the dialog doesn't always reliably hand
                       off real OS keyboard focus to the dialog's search box, see
                       file-email-dialog.html's own header comment and its focusWhenReady()
                       retry helper, which was kept specifically in case this day came. -->
                  <Control xsi:type="Button" id="Summation.FileEmailButton">
                    <Label resid="FileEmailButtonLabel" />
                    <Supertip>
                      <Title resid="FileEmailButtonLabel" />
                      <Description resid="FileEmailButtonToolTip" />
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.16x16" />
                      <bt:Image size="32" resid="Icon.32x32" />
                      <bt:Image size="80" resid="Icon.80x80" />
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="FileEmail.Url" />
                      <SupportsPinning>true</SupportsPinning>
                      <SupportsNoItemContext>true</SupportsNoItemContext>
                      <SupportsMultiSelect>true</SupportsMultiSelect>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>

            <ExtensionPoint xsi:type="MessageComposeCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="SummationToolsComposeGroup">
                  <Label resid="GroupLabel" />
                  <!-- SourceLocation changed 2026-10-16 from Taskpane.Url (the pane's general
                       menu) to FileOnCompose.Url, a deep link straight to the project-filing
                       picker. This button's id also doubles as the InsightMessage "Choose
                       project" action's commandId (commands.js's onMessageComposeHandler), so
                       both the manual click and the banner now land in the same place. The
                       general menu's other tools (New Project, shared mailbox management, etc.)
                       aren't relevant mid-compose anyway. -->
                  <Control xsi:type="Button" id="Summation.ComposeTaskpaneButton">
                    <Label resid="TaskpaneButtonLabel" />
                    <Supertip>
                      <Title resid="TaskpaneButtonLabel" />
                      <Description resid="TaskpaneButtonToolTip" />
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.16x16" />
                      <bt:Image size="32" resid="Icon.32x32" />
                      <bt:Image size="80" resid="Icon.80x80" />
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="FileOnCompose.Url" />
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>
      <Resources>
        <bt:Images>
          <bt:Image id="Icon.16x16" DefaultValue="https://prassummation.github.io/outlook-addin/logo-symbol-16x16.png" />
          <bt:Image id="Icon.32x32" DefaultValue="https://prassummation.github.io/outlook-addin/logo-symbol-32x32.png" />
          <bt:Image id="Icon.80x80" DefaultValue="https://prassummation.github.io/outlook-addin/logo-symbol-80x80.png" />
        </bt:Images>
        <bt:Urls>
          <bt:Url id="Taskpane.Url" DefaultValue="https://prassummation.github.io/outlook-addin/taskpane.html" />
          <bt:Url id="FileEmail.Url" DefaultValue="https://prassummation.github.io/outlook-addin/taskpane.html?view=fileEmail" />
          <bt:Url id="FileOnCompose.Url" DefaultValue="https://prassummation.github.io/outlook-addin/taskpane.html?view=fileOnCompose" />
          <bt:Url id="Commands.Url" DefaultValue="https://prassummation.github.io/outlook-addin/commands.html" />
          <bt:Url id="CommandsJs.Url" DefaultValue="https://prassummation.github.io/outlook-addin/commands.js" />
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="GroupLabel" DefaultValue="Summation Tools" />
          <bt:String id="TaskpaneButtonLabel" DefaultValue="Summation Assistant" />
          <bt:String id="FileEmailButtonLabel" DefaultValue="File Email" />
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="TaskpaneButtonToolTip" DefaultValue="Open the Summation AI helper." />
          <bt:String id="FileEmailButtonToolTip" DefaultValue="Tag the selected email(s) with a project and stage them for filing." />
        </bt:LongStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
